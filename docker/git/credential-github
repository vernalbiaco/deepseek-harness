#!/bin/sh
# git credential helper for github.com inside the dsh containers, mounted at
# /usr/local/bin/git-credential-github and selected by docker/git/gitconfig.
#
# The token arrives as a file rather than an environment variable: the
# harness subprocess seam drops every credential-shaped name (KEY, PASSWORD,
# SECRET, TOKEN) from the environment an agent tool command inherits, so a
# GITHUB_TOKEN variable would be visible to `docker compose exec` yet absent
# when the agent itself runs `git push`. The host file ./secrets/github-token
# is bind-mounted read-only under /etc/dsh/secrets.
set -eu

token_file=/etc/dsh/secrets/github-token

# git sends the request description on stdin; drain it so git never sees a
# closed pipe, then answer only the `get` action.
cat >/dev/null
[ "${1:-}" = get ] || exit 0

if [ ! -s "$token_file" ]; then
  echo "git-credential-github: no GitHub token at $token_file; write a token with push access to ./secrets/github-token on the host and recreate the service" >&2
  exit 1
fi

printf 'username=x-access-token\npassword=%s\n' "$(tr -d '\r\n' < "$token_file")"
