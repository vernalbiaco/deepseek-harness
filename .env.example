DEEPSEEK_API_KEY=

# DEEPSEEK_BASE_URL cannot live in this file. dsh accepts it only from the
# launching environment: the repository is bind-mounted at /workspace, so .env
# is also /workspace/.env, a file the agent can edit, and it must not be able to
# redirect where the agent reaches the network. docker-compose.omni-wire.yml
# sets it through Compose's `environment:`, which is the launching environment.

# OmniRoute gateway. Both are required to reach the gateway, and an empty value
# fails as loudly as an absent one. OMNIROUTE_API_KEY is minted from the
# dashboard that OMNIROUTE_INITIAL_PASSWORD opens; see 'make docker-omni-key'.
# It may stay empty for a first 'make docker-all': that target starts the
# gateway before it checks, so the dashboard is up to mint the key from.
# The harness services read OMNIROUTE_API_KEY in place of DEEPSEEK_API_KEY when
# routed through the gateway, so one .env serves gateway and direct modes.
OMNIROUTE_INITIAL_PASSWORD=
OMNIROUTE_API_KEY=
